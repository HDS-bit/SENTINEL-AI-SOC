# Backend Container
FROM node:20-alpine
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=5000
ENV HOST=0.0.0.0

COPY server/package*.json ./
RUN npm ci --omit=dev || npm install --omit=dev
COPY server/ ./

RUN mkdir -p /app/data/uploads && chmod -R 777 /app/data

EXPOSE 5000

CMD ["node", "server.js"]
