# ==============================================================================
# CSTD SENTINEL AI SOC - Production Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# JWT Authentication Secret Key (Generate a random 64-char string in production)
JWT_SECRET=sentinel-super-secret-cyber-soc-jwt-key-2025-defense-token
JWT_EXPIRES_IN=24h

# Google Gemini API Key for Server-Side Cybersecurity Intelligence Gateway
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# CORS Allowed Origins (comma-separated, leave blank for all)
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# Optional Firebase Identity Config (for Enterprise SSO)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
